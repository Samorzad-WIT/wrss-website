# FRONTEND (React / Vite)

# Linki do narzędzi zewnętrznych (Vite wymaga prefiksu VITE_)
VITE_QR_LINK=https://link-do-qr.pl
VITE_WINIETKI_LINK=https://link-do-winietek.pl
VITE_PUNKTY_LINK=https://link-do-punktow.pl

# Adres docelowy API backendu, z którym komunikuje się frontend
VITE_API_URL=http://localhost:3000

# BACKEND (Node.js / Express w folderze server/)

# Opcjonalne: domeny, z których API przyjmuje żądania (domyślnie localhost). Rozdziel przecinkami.
# CORS_ORIGIN=https://twojadomena.pl,https://www.twojadomena.pl

# Połączenie z bazą PostgreSQL
DATABASE_URL=postgresql://uzytkownik:haslo@localhost:5432/wrss_db

# Tajny klucz do szyfrowania sesji (wygeneruj dowolny długi ciąg znaków)
JWT_SECRET=super_tajny_klucz_zmien_mnie

# Dane logowania do panelu administratora
ADMIN_USERNAME=admin

# Hasło musi być zahashowane! Użyj skryptu: node server/hash-password.mjs
ADMIN_PASSWORD_HASH=tu_wklej_wynik_skryptu
